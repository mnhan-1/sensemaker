    {
      "@id": "item_06",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Local Candidate Information Gaps",
      "description": "Voters lack easily accessible, actionable information about local county-level candidates, often relying heavily on name recognition from campaign signs.",
      "x": 704,
      "y": 0,
      "w": 240,
      "h": 110,
