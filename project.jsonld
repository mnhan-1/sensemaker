      "@id": "item_04",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Ranked Choice Voting Education",
      "description": "The implementation of ranked choice voting lacks sufficient public education to help voters understand its systemic benefits and how it changes voting behaviors.",
