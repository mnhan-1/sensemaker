    },
    {
      "@id": "item_10",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Civic Distrust & Disinformation",
      "description": "A toxic combination of distrust in voting, a lack of civics literacy, and internet-era disinformation is allowing political entities to manipulate voters' worst instincts.",
      "x": 3480,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-11",
      "children": []
    },
    {
      "@id": "item_11",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Logistical & Educational Barriers to Voting",
      "description": "Voting is burdened by physical hurdles (childcare, time off work) and a lack of plain-language education on how local elections directly impact citizens' daily lives.",
      "x": 1000,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-12",
      "children": []
    },
    {
      "@id": "item_12",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "The Death of Political Compromise",
      "description": "The electorate and activists are failing to recognize that compromise is a fundamental component of democracy, negatively impacting civic engagement.",
      "x": 4888,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-13",
      "children": []
    },
    {
      "@id": "item_13",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Civics Talent Pipeline Shortage",
      "description": "There is a noticeable shortage of talent to fill junior roles within the civics and elections workforce.",
      "x": 2184,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-14",
      "children": []
    },
    {
      "@id": "item_14",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "False Transparency in Government",
      "description": "Government agencies and schools exhibit a disconnect with their constituencies, presenting a 'false flag' of transparency that leaves communities feeling ignored without understanding how aggregate sentiment is utilized.",
      "x": 888,
      "y": 475,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-15",
      "children": []
    },
    {
      "@id": "item_15",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "AI Bot Interference in Constituent Engagement",
      "description": "Artificial intelligence is being used to flood communication channels, rendering actual, organic constituent engagement ineffective.",
      "x": 1184,
      "y": 475,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-16",
      "children": []
    },
    {
      "@id": "item_16",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Hopelessness & Lack of Election Information",
      "description": "Voters feel hopeless and lack basic awareness of when local elections occur, relying on passive information like mailers or word of mouth.",
      "x": 3888,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-17",
      "children": []
    },
    {
      "@id": "item_17",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Structural Election Imbalances",
      "description": "The current electoral system features gerrymandering, dominant two-party privileges, and districts so large that politicians effectively choose their voters.",
      "x": 6592,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-18",
      "children": []
    },
    {
      "@id": "item_18",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Political Bubbles & NIMBYism",
      "description": "Citizens are highly polarized and isolated in social bubbles, proposing solutions or pushing back on reforms without understanding the broader impacts, trade-offs, or equity implications beyond their circles.",
      "x": 1480,
      "y": 475,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-19",
      "children": []
    },
    {
      "@id": "item_19",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Volunteer Burnout & Knowledge Transfer",
      "description": "Local volunteer roles, such as PTA leadership, fall on a few individuals. There is a need for tools to reduce the operational burden and retain institutional knowledge as volunteer leadership turns over.",
      "x": 1776,
      "y": 475,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-19",
      "children": []
    },
    {
      "@id": "item_20",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Aging Civic Leadership",
      "description": "Local civic organizations are heavily reliant on aging populations for leadership and membership, struggling to recruit younger generations who face competing career and family priorities.",
      "x": 0,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-20",
      "children": []
    },
    {
      "@id": "item_21",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Uncontested Local Candidate Transparency",
      "description": "It is incredibly difficult to research the records of local election candidates, especially those running uncontested or without a communications budget, leaving voters feeling uninformed.",
      "x": 296,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-21",
      "children": []
    },
    {
      "@id": "item_22",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Unexplained Ballot Roles",
      "description": "Even where ranked-choice mechanics were well taught, voters lack a plain-language breakdown of what each office on the ballot actually does, leaving first-time voters guessing at the roles they're electing.",
      "x": 592,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-22",
      "children": []
    },
    {
      "@id": "item_24",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Loneliness as a Civic Problem",
      "description": "The social scaffolding that once created accountability in how people form relationships has dissolved with nothing replacing it — an isolation epidemic treated as a private matter rather than missing civic infrastructure.",
      "x": 888,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-24",
      "children": []
    },
    {
      "@id": "item_25",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Outdated Small-Organization Elections",
      "description": "Unions, HOAs, and nonprofit boards run consequential elections on paper ballots and opaque spreadsheets; available tools serve incumbent leadership rather than transparent, verifiable results for members.",
      "x": 1184,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-25",
      "children": []
    },
    {
      "@id": "item_26",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Eroded Respect for Disagreement",
      "description": "People can no longer agree to disagree — basic respect for others and their opinions is missing from civic life, and active listening is rare.",
      "x": 5184,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-26",
      "children": []
    },
    {
      "@id": "item_27",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Misunderstood Pace of Government",
      "description": "Constituents misjudge who holds which powers and how fast government was designed to move, so legitimate slowness reads as failure — and stretched congressional staff can't give every issue the weight visitors expect.",
      "x": 1480,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-27",
      "children": []
    },
    {
      "@id": "item_28",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Cross-Jurisdiction Election Distrust",
      "description": "Election officials struggle to cut through fragmented information channels, and even people who trust their own town's elections increasingly distrust elections run by other cities and states.",
      "x": 1776,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-28",
      "children": []
    },
    {
      "@id": "item_29",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "No Playbook for Good Citizenship",
      "description": "There is no clear guide to the daily, weekly, and monthly steps of being an informed, participating citizen — the information is scattered everywhere, and the whole project feels overwhelming.",
      "x": 0,
      "y": 825,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-29",
      "children": []
    },
    {
      "@id": "item_30",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Broad Civic Disengagement",
      "description": "Many people are not engaged in local or national politics, don't know who the candidates are or what they stand for, and don't vote — despite candidate forums and get-out-the-vote efforts.",
      "x": 4184,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-30",
      "children": []
    },
    {
      "@id": "item_31",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Missing Dialogue Across Difference",
      "description": "People who hold differing views about a topic rarely talk with each other; new civic-engagement software is being tried, with only some success.",
      "x": 4592,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-31",
      "children": []
    },
    {
      "@id": "item_32",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Untapped Personal Megaphones",
      "description": "People forget how influential they can be with the biggest megaphone in history in the palm of their hand — but no one has cracked engagement at scale without it devolving into a rage machine.",
      "x": 296,
      "y": 825,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-32",
      "children": []
    },
    {
      "@id": "item_33",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Low-Information Voting & Gerrymandering",
      "description": "Many voters don't research candidates before an election, while nationwide gerrymandering and proposed federal voting restrictions make the underlying playing field less fair.",
      "x": 6296,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-33",
      "children": []
    },
    {
      "@id": "item_34",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Ranked-Choice Confusion Persists",
      "description": "Voters remain confused about how ranked choice voting works and still lack clear, unbiased information about the candidates themselves.",
      "x": 5592,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-34",
      "children": []
    },
    {
      "@id": "item_35",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Anemic, Uneven Participation",
      "description": "Civic participation is thin, and only some voices get heard and lifted.",
      "x": 1888,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-35",
      "children": []
    },
    {
      "@id": "item_36",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Constituent Mail Black Hole",
      "description": "Letters and emails to representatives feel like talking into a void — heartfelt messages come back as generic, strategist-polished boilerplate.",
      "x": 2480,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-36",
      "children": []
    },
    {
      "@id": "item_37",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Entertainment Crowds Out Civic Attention",
      "description": "Citizens are too busy consuming entertainment to pay attention to neighborhood issues, kids' activities, or their government; outreach across multiple mediums still meets 'I don't have time'.",
      "x": 592,
      "y": 825,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-37",
      "children": []
    },
    {
      "@id": "item_38",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Complacency & Candidate Deterrence",
      "description": "The average citizen doesn't feel they can make a difference, and good people stay away from political office because media can form any narrative it wants about them.",
      "x": 2776,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-38",
      "children": []
    },
    {
      "@id": "item_39",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Calls for Stricter Ballot ID",
      "description": "A demand that in-person voting require Real ID and that mail-in ballots require verified identification — described by the submitter as widely supported yet repeatedly rejected.",
      "x": 888,
      "y": 825,
      "w": 240,
      "h": 110,
