    {
      "@id": "item_07",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Public Engagement on Government AI",
      "description": "Citizens lack the tools and platforms to provide feedback on or inform how government agencies and companies deploy artificial intelligence in their communities.",
      "x": 592,
      "y": 475,
      "w": 240,
      "h": 110,
