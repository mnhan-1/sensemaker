    {
      "@id": "item_05",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Targeting Legislative Influence",
      "description": "It is currently too labor-intensive and expensive to identify the most effective individuals or groups to lobby specific legislators on specific issues at the right time.",
      "x": 296,
      "y": 475,
      "w": 240,
      "h": 110,
